# ══════════════════════════════════════════════════════════════
# Paper Flow AI — Local Development (OpenAI)
# ══════════════════════════════════════════════════════════════
# Usage:  copy .env.local-openai .env   (then paste your key)
# ══════════════════════════════════════════════════════════════

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=securepassword
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=research_assistant
DATABASE_URL=postgresql+asyncpg://admin:securepassword@postgres:5432/research_assistant

# ── Qdrant ────────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ══════════════════════════════════════════════════════════════
# LLM — Single OpenAI API key for all services
# ══════════════════════════════════════════════════════════════
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-PASTE_YOUR_OPENAI_KEY_HERE

# All services use the same OpenAI key (no per-service split needed)
CHAT_LLM_PROVIDER=openai
SUMMARIZATION_LLM_PROVIDER=openai
TRANSLATION_LLM_PROVIDER=openai
QA_LLM_PROVIDER=openai
AGENT_LLM_PROVIDER=openai

# ── Other LLM Keys (leave empty) ─────────────────────────────
GEMINI_API_KEY=
GEMINI_API_KEY_2=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
COHERE_API_KEY=

# ── LLM Settings ─────────────────────────────────────────────
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3
LLM_MAX_CONCURRENT=5
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1000

# ── NLP Modes (use LLM for everything via OpenAI) ────────────
SUMMARIZATION_MODE=llm
QA_MODE=llm
TRANSLATION_EN_AR_MODE=llm
TRANSLATION_AR_EN_MODE=llm

# ── OCR (PaddleOCR — runs locally, free, no API needed) ──────
OCR_ENGINE=paddle
MISTRAL_API_KEY=
LIGHTON_API_KEY=
OCR_API_TIMEOUT=60
# For LLM OCR using OpenAI:
LLM_OCR_MODEL=openai/gpt-4o-mini

# ── Voice (Whisper local STT + Edge TTS free) ─────────────────
STT_PROVIDER=whisper
TTS_PROVIDER=edge_tts
ELEVENLABS_API_KEY=
ELEVENLABS_STT_VOICE_AR=
ELEVENLABS_TTS_VOICE_EN=

# ── Rate Limits ───────────────────────────────────────────────
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_SUMMARIZE=10/minute
RATE_LIMIT_TRANSLATE=10/minute
RATE_LIMIT_OCR=5/minute
RATE_LIMIT_STT=20/minute
RATE_LIMIT_TTS=20/minute

# ── Storage ───────────────────────────────────────────────────
UPLOAD_DIR=/app/storage/uploads
AGENT_DOWNLOAD_DIR=/app/storage/agent_downloads
STORAGE_BACKEND=local
GCS_BUCKET_NAME=

# ── App ───────────────────────────────────────────────────────
DEBUG=true
SECRET_KEY=local-dev-secret-key-change-in-prod
SEMANTIC_SCHOLAR_API_KEY=

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
